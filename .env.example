# =============================================================================
# Bensal Investment Co. Ltd — Environment Configuration (example)
# Copy this file to `.env` and fill in real values. Never commit `.env`.
# =============================================================================

# --- Database ----------------------------------------------------------------
# Credentials for the Postgres container defined in docker-compose.yml.
POSTGRES_USER=bensal
POSTGRES_PASSWORD=change_me
POSTGRES_DB=bensal
POSTGRES_PORT=5433
# Full connection string Prisma uses. Must match the vars above when using
# docker-compose locally; point it at your managed Postgres instance in prod.
# Using 5433 on the host by default to avoid clashing with a locally
# installed Postgres service that may already own port 5432.
DATABASE_URL="postgresql://bensal:change_me@localhost:5433/bensal?schema=public"

# --- App -----------------------------------------------------------------
NODE_ENV=development
# Port the Next.js container listens on / is published on.
APP_PORT=3000
# Public base URL of the site (used for absolute links, emails, sitemap).
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- NextAuth ---------------------------------------------------------------
# Random secret used to sign session/JWT tokens. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NEXTAUTH_SECRET=""
# Canonical URL of the deployed app (must match production origin in prod).
NEXTAUTH_URL="http://localhost:3000"

# --- Seeded admin user --------------------------------------------------
# Used only once by `pnpm prisma:seed` to create the first admin account.
# Change the password immediately after first login.
SEED_ADMIN_NAME="Bensal Admin"
SEED_ADMIN_EMAIL="admin@bensal.co.tz"
SEED_ADMIN_PASSWORD=""

# --- SMTP / Email (Nodemailer) ----------------------------------------------
# SMTP credentials used to send contact-form / career-application emails.
SMTP_HOST="smtp.example.com"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=""
SMTP_PASSWORD=""
# "From" header used on all outbound system emails.
MAIL_FROM="Bensal Investment Co. Ltd <no-reply@bensal.co.tz>"
# Where contact-form / quotation-request notifications are sent.
CONTACT_NOTIFICATION_EMAIL="md@bensal.co.tz"

# --- Uploads -----------------------------------------------------------------
# Local disk directory for contact/career file uploads (Docker volume in prod).
UPLOAD_DIR="./public/uploads"
# Kept well under Vercel's hard, non-configurable 4.5MB serverless request
# body limit — see the bodySizeLimit comment in next.config.ts. Raising
# this only matters for Docker/self-hosted deployments, which aren't
# subject to that platform limit.
MAX_UPLOAD_SIZE_MB=3
# Set only on Vercel (via a linked Blob store — Storage tab in the dashboard).
# When present, uploads go to Vercel Blob instead of local disk, since
# serverless functions don't have a writable/persistent filesystem. Leave
# unset for Docker/local dev.
BLOB_READ_WRITE_TOKEN=""

# --- Rate limiting ------------------------------------------------------------
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=10
